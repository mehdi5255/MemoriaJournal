# Copiez ce fichier en .env et remplissez les valeurs (ne jamais commiter .env)
SECRET_KEY=remplacez-moi-par-une-longue-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
GEMINI_API_KEY=
HF_TOKEN=
REDIS_URL=redis://localhost:6379/0

# Moteur des illustrations : huggingface (SDXL, par défaut), local (SD-Turbo sur CPU, gratuit)
# ou auto (Hugging Face puis SD-Turbo local si l'API échoue, par exemple plus de crédit)
IMAGE_BACKEND=huggingface

# Transcription et émotions : huggingface (défaut), local (CPU, gratuit) ou auto (secours local)
VOICE_BACKEND=huggingface

# Légende et objets des photos : huggingface (défaut), local (CPU) ou auto (secours local)
FACE_BACKEND=huggingface

# REMINDER : huggingface (défaut), local (CPU) ou auto (secours local)
REMINDER_BACKEND=huggingface

# JOURNAL : huggingface (défaut), local (CPU) ou auto (secours local)
JOURNAL_BACKEND=huggingface

# Adresse du site dans les e-mails de rappel
SITE_URL=http://127.0.0.1:8000
